{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/kikitan_new.ico"
    ],
    "resources": [
      "./desktopoverlay"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Kikitan Translator",
  "version": "1.3.0",
  "identifier": "com.github.yusufozmen01.kikitan",
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 625,
        "minHeight": 625,
        "minWidth": 900,
        "title": "Kikitan Translator",
        "width": 900
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; frame-src 'self' https:; child-src 'self' https:; connect-src 'self' https: http://localhost:* https://translate.googleapis.com https://generativelanguage.googleapis.com https://gist.githubusercontent.com wss:; font-src 'self' https: data:;"
    }
  }
}